# Copier ce fichier en .env puis renseigner les valeurs du projet Supabase
# (Supabase > Project Settings > API). La clé publique ("publishable" / "anon") est publique par conception :
# la sécurité repose sur les règles RLS et les fonctions de supabase/schema.sql.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
